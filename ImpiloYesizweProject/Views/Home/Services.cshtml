@{
    ViewData["Title"] = "Services";
}

<section class="py-5 bg-light">
    <div class="container">

        <div class="text-center mb-5">
            <h1 class="display-4 fw-bold text-success">
                Our Services
            </h1>

            <p class="lead text-muted">
                Empowering communities through sustainable programmes.
            </p>
        </div>

        <div class="row g-4">

            <div class="col-md-4">
                <div class="card h-100 shadow border-0 p-4 text-center">
                    <div class="display-3">🏥</div>
                    <h3 class="mt-3">Healthcare</h3>
                    <p>
                        HIV counselling, TB support,
                        wellness programmes and home-based care.
                    </p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card h-100 shadow border-0 p-4 text-center">
                    <div class="display-3">📚</div>
                    <h3 class="mt-3">Education</h3>
                    <p>
                        School support, youth development,
                        homework assistance and life skills.
                    </p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card h-100 shadow border-0 p-4 text-center">
                    <div class="display-3">🥗</div>
                    <h3 class="mt-3">Nutrition</h3>
                    <p>
                        Food parcels and nutritional support
                        for vulnerable families.
                    </p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card h-100 shadow border-0 p-4 text-center">
                    <div class="display-3">👨‍👩‍👧</div>
                    <h3 class="mt-3">Family Support</h3>
                    <p>
                        Counselling, family assistance
                        and social support programmes.
                    </p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card h-100 shadow border-0 p-4 text-center">
                    <div class="display-3">🤝</div>
                    <h3 class="mt-3">Community Outreach</h3>
                    <p>
                        Community development,
                        awareness campaigns and volunteer programmes.
                    </p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card h-100 shadow border-0 p-4 text-center">
                    <div class="display-3">❤️</div>
                    <h3 class="mt-3">Care Programmes</h3>
                    <p>
                        Providing hope, dignity
                        and compassionate care to those in need.
                    </p>
                </div>
            </div>

        </div>

    </div>
</section>