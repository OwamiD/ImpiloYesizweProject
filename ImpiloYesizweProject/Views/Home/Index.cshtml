<!-- ==================== CONTACT SECTION ==================== -->

<section class="contact-section" id="contact">

    <div class="container">

        <div class="contact-heading text-center mx-auto">
            <span class="section-eyebrow">WE ARE HERE FOR YOU</span>

            <h2>Let's Start a Conversation</h2>

            <p>
                Have a question, need support or want to work with us?
                We'd love to hear from you.
            </p>
        </div>

        <div class="row g-4 align-items-stretch">

            <!-- Contact Information -->
            <div class="col-lg-5">

                <div class="contact-information">

                    <span class="contact-info-label">
                        GET IN TOUCH
                    </span>

                    <h3>Connect With Our Team</h3>

                    <p class="contact-info-description">
                        Reach out to ImpiloYesizwe Care Community
                        Project. We're ready to hear from you.
                    </p>

                    <div class="contact-detail">

                        <div class="contact-detail-icon">📱</div>

                        <div>
                            <span>WHATSAPP / PHONE</span>
                            <a href="https://wa.me/27712667607"
                               target="_blank"
                               rel="noopener noreferrer">
                                +27 71 266 7607
                            </a>
                        </div>

                    </div>

                    <div class="contact-detail">

                        <div class="contact-detail-icon">💬</div>

                        <div>
                            <span>QUICK ENQUIRIES</span>
                            <p>Send our team a WhatsApp message.</p>
                        </div>

                    </div>

                    <div class="contact-social-note">
                        <span>💚</span>
                        <p>
                            Every conversation is an opportunity
                            to make a positive difference.
                        </p>
                    </div>

                    <a href="https://wa.me/27712667607"
                       target="_blank"
                       rel="noopener noreferrer"
                       class="contact-whatsapp-btn">
                        Chat With Us on WhatsApp
                        <span>→</span>
                    </a>

                </div>

            </div>

            <!-- Contact Form -->
            <div class="col-lg-7">

                <div class="contact-form-card">

                    <div class="contact-form-heading">
                        <h3>Send Us a Message</h3>
                        <p>
                            Complete the form below and we'll
                            get back to you.
                        </p>
                    </div>

                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success text-center" role="status">
                            @TempData["Success"]
                        </div>
                    }

                    <form method="post"
                          asp-controller="Home"
                          asp-action="Contact">

                        <div class="row g-3">

                            <div class="col-md-6">
                                <label for="FullName" class="form-label">
                                    Full Name
                                </label>

                                <input type="text"
                                       id="FullName"
                                       name="FullName"
                                       class="form-control contact-input"
                                       placeholder="Enter your full name"
                                       autocomplete="name"
                                       required>
                            </div>

                            <div class="col-md-6">
                                <label for="Email" class="form-label">
                                    Email Address
                                </label>

                                <input type="email"
                                       id="Email"
                                       name="Email"
                                       class="form-control contact-input"
                                       placeholder="Enter your email"
                                       autocomplete="email"
                                       required>
                            </div>

                            <div class="col-12">
                                <label for="Phone" class="form-label">
                                    Phone Number <span>(Optional)</span>
                                </label>

                                <input type="tel"
                                       id="Phone"
                                       name="Phone"
                                       class="form-control contact-input"
                                       placeholder="Enter your phone number"
                                       autocomplete="tel">
                            </div>

                            <div class="col-12">
                                <label for="Message" class="form-label">
                                    Your Message
                                </label>

                                <textarea id="Message"
                                          name="Message"
                                          class="form-control contact-input"
                                          rows="5"
                                          placeholder="How can we help you?"
                                          required></textarea>
                            </div>

                            <div class="col-12">
                                <button type="submit"
                                        class="contact-submit-btn">
                                    Send Message
                                    <span>→</span>
                                </button>
                            </div>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</section>
