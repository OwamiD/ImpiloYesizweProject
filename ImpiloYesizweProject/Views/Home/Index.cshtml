@{
    ViewData["Title"] = "Home";
}

<!-- ==================== HERO SECTION ==================== -->
<section class="hero py-5">
    <div class="container">
        <div class="row align-items-center gy-5">
            <div class="col-lg-6">
                <h1 class="display-4 fw-bold text-success mb-3">
                    Together We Can Build Stronger Communities
                </h1>
                <p class="lead text-muted mb-4">
                    Helping vulnerable children, families and communities through education, healthcare and social support.
                </p>
                <div class="d-flex flex-wrap gap-3">
                    <a href="#about" class="btn btn-success btn-lg px-4">Learn More</a>
                    <a href="#donate" class="btn btn-outline-success btn-lg px-4">Donate Now</a>
                </div>
            </div>
            <div class="col-lg-6 text-center">
                <img src="~/images/hero.png"
                     class="img-fluid rounded-3 shadow-sm"
                     alt="ImpiloYesizwe Care Community Project Logo"
                     style="max-height: 420px;">
            </div>
        </div>
    </div>
</section>

<!-- ==================== SERVICES SECTION ==================== -->
<section class="services py-5 bg-light" id="services">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="fw-bold text-success">Our Services</h2>
            <p class="text-muted col-lg-8 mx-auto">
                We are committed to improving lives through community-based care and support.
            </p>
        </div>

        <div class="row g-4">
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 border-0 shadow-sm text-center p-4">
                    <div class="display-4 mb-3">👨‍👩‍👧</div>
                    <h4 class="fw-semibold">Child & Youth Care</h4>
                    <p class="text-muted mb-0">
                        Supporting children through education, homework assistance and youth development programmes.
                    </p>
                </div>
            </div>

            <div class="col-md-6 col-lg-4">
                <div class="card h-100 border-0 shadow-sm text-center p-4">
                    <div class="display-4 mb-3">🥗</div>
                    <h4 class="fw-semibold">Nutritional Support</h4>
                    <p class="text-muted mb-0">
                        Providing food parcels and nutritional assistance to vulnerable families in need.
                    </p>
                </div>
            </div>

            <div class="col-md-6 col-lg-4">
                <div class="card h-100 border-0 shadow-sm text-center p-4">
                    <div class="display-4 mb-3">🏥</div>
                    <h4 class="fw-semibold">Healthcare Support</h4>
                    <p class="text-muted mb-0">
                        HIV counselling, TB support and promoting healthy, resilient communities.
                    </p>
                </div>
            </div>

            <div class="col-md-6 col-lg-4">
                <div class="card h-100 border-0 shadow-sm text-center p-4">
                    <div class="display-4 mb-3">🏠</div>
                    <h4 class="fw-semibold">Home-Based Care</h4>
                    <p class="text-muted mb-0">
                        Caring for individuals who need practical and emotional support in their own homes.
                    </p>
                </div>
            </div>

            <div class="col-md-6 col-lg-4">
                <div class="card h-100 border-0 shadow-sm text-center p-4">
                    <div class="display-4 mb-3">🤝</div>
                    <h4 class="fw-semibold">Community Partnerships</h4>
                    <p class="text-muted mb-0">
                        Working with partners to strengthen healthcare access and overall community wellbeing.
                    </p>
                </div>
            </div>

            <div class="col-md-6 col-lg-4">
                <div class="card h-100 border-0 shadow-sm text-center p-4">
                    <div class="display-4 mb-3">📚</div>
                    <h4 class="fw-semibold">Education Support</h4>
                    <p class="text-muted mb-0">
                        Helping children stay in school with stationery, uniforms and after-school programmes.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- ==================== OUR IMPACT ==================== -->
<section class="impact py-5">
    <div class="container">

        <div class="text-center mb-5">
            <h2 class="fw-bold text-success">Our Impact</h2>
            <p class="text-muted">
                Every act of kindness makes a difference.
            </p>
        </div>

        <div class="row text-center">

            <div class="col-md-3 mb-4">
                <div class="impact-card">
                    <h1 class="text-success fw-bold">500+</h1>
                    <p>Families Supported</p>
                </div>
            </div>

            <div class="col-md-3 mb-4">
                <div class="impact-card">
                    <h1 class="text-success fw-bold">300+</h1>
                    <p>Children Assisted</p>
                </div>
            </div>

            <div class="col-md-3 mb-4">
                <div class="impact-card">
                    <h1 class="text-success fw-bold">25+</h1>
                    <p>Community Care Workers</p>
                </div>
            </div>

            <div class="col-md-3 mb-4">
                <div class="impact-card">
                    <h1 class="text-success fw-bold">10+</h1>
                    <p>Years of Service</p>
                </div>
            </div>

        </div>

    </div>
</section>
<!-- ==================== GALLERY ==================== -->
<section class="gallery py-5 bg-light" id="gallery">

    <div class="container">

        <div class="text-center mb-5">
            <h2 class="fw-bold text-success">
                Community Gallery
            </h2>

            <p class="text-muted">
                Moments from our programmes and community outreach.
            </p>
        </div>

        <div class="row g-4">

            <div class="col-md-4">
                <img src="~/images/gallery1.jpg"
                     class="img-fluid rounded shadow"
                     alt="Gallery Image">
            </div>

            <div class="col-md-4">
                <img src="~/images/gallery2.jpg"
                     class="img-fluid rounded shadow"
                     alt="Gallery Image">
            </div>

            <div class="col-md-4">
                <img src="~/images/gallery3.jpg"
                     class="img-fluid rounded shadow"
                     alt="Gallery Image">
            </div>

        </div>

    </div>

</section>

<!-- ==================== ABOUT SECTION ==================== -->
<section class="about-section py-5" id="about">
    <div class="container">
        <div class="row align-items-center gy-4">
            <div class="col-lg-6">
                <h2 class="fw-bold text-success mb-3">About ImpiloYesizwe</h2>
                <p>
                    ImpiloYesizwe Care Community Project is a community-based organisation dedicated to supporting vulnerable children, families and individuals.
                    We believe that every person deserves access to care, education and dignity.
                </p>
                <p>
                    Through our various programmes — from nutritional support and home-based care to youth development — we work hand-in-hand with communities to create lasting positive change.
                </p>
                <a href="#contact" class="btn btn-success mt-2">Get In Touch</a>
            </div>
            <div class="col-lg-6 text-center">
                <!-- You can add an about image later -->
            </div>
        </div>
    </div>
</section>

<!-- ==================== DONATE SECTION ==================== -->
<section class="py-5 bg-light" id="donate">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8 text-center">
                <h2 class="fw-bold text-success mb-3">Support Our Work</h2>
                <p class="text-muted mb-4">
                    Your donation helps us continue providing care, food, education and support to those who need it most.
                </p>
                <a href="#contact" class="btn btn-success btn-lg px-5">Donate / Contact Us</a>
            </div>
        </div>
    </div>
</section>

<!-- ==================== CONTACT SECTION ==================== -->
<section class="py-5" id="contact">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="fw-bold text-success">Contact Us</h2>
            <p class="text-muted">We would love to hear from you</p>
        </div>

        <div class="row justify-content-center">
            <div class="col-lg-8">
                <form>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Full Name</label>
                            <input type="text" class="form-control" placeholder="Your name" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Email Address</label>
                            <input type="email" class="form-control" placeholder="your@email.com" required>
                        </div>
                        <div class="col-12">
                            <label class="form-label">Phone Number</label>
                            <input type="tel" class="form-control" placeholder="Optional">
                        </div>
                        <div class="col-12">
                            <label class="form-label">Message</label>
                            <textarea class="form-control" rows="5" placeholder="How can we help you?" required></textarea>
                        </div>
                        <div class="col-12 text-center">
                            <button type="submit" class="btn btn-success btn-lg px-5">Send Message</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>