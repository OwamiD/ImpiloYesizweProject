@model IEnumerable<ImpiloYesizweProject.Models.GalleryImage>
@{
    ViewData["Title"] = "Home";
}


<!-- ==================== REDESIGNED HERO ==================== -->
<section class="hero hero-redesign">
    <div class="container">
        <div class="row align-items-center g-5">

            <div class="col-lg-6 hero-copy">

                <div class="hero-eyebrow">
                    <span class="hero-dot"></span>
                    COMMUNITY CARE • EDUCATION • SUPPORT
                </div>

                <h1>
                    Stronger Communities Start With
                    <span>Care and Opportunity.</span>
                </h1>

                <p class="hero-description">
                    ImpiloYesizwe Care Community Project is dedicated
                    to supporting vulnerable children, families and
                    individuals through community-driven care,
                    education and social support.
                </p>

                <div class="hero-actions">
                    <a href="#services" class="hero-primary-btn">
                        Explore Our Services
                        <span>→</span>
                    </a>

                    <a href="#donate" class="hero-secondary-btn">
                        Support Our Work
                    </a>
                </div>

                <div class="hero-highlights">
                    <span>✓ Child & Youth Care</span>
                    <span>✓ Family Support</span>
                    <span>✓ Community Development</span>
                </div>

            </div>

            <div class="col-lg-6">

                <div class="hero-visual">

                    <div class="hero-logo-card">
                        <img src="~/images/hero.png"
                             alt="ImpiloYesizwe Care Community Project Logo"
                             class="hero-logo">
                    </div>

                    <div class="hero-caption">
                        <span>CARE. DIGNITY. OPPORTUNITY.</span>
                        <p>Building a stronger future together.</p>
                    </div>

                </div>

            </div>

        </div>
    </div>
</section>


<!-- ==================== SERVICES SECTION ==================== -->

<section class="services-section" id="services">
    <div class="container">

