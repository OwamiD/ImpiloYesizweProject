                                for young people.
                            </p>

                        </article>
                    </div>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- ==================== COMMUNITY GALLERY ==================== -->

<div class="row g-4">

    @if (Model != null && Model.Any())
    {
        foreach (var image in Model)
        {
            <div class="col-md-6 col-lg-4">
                <article class="gallery-card">

                    <div class="gallery-image-wrap">
                        <img src="@image.ImageUrl"
                             loading="lazy"
                             alt="@image.Title">
                    </div>

                    <div class="gallery-card-body">

                        <span class="gallery-category">
                            @(string.IsNullOrWhiteSpace(image.Category)
                                ? "COMMUNITY"
                                : image.Category)
                        </span>

                        <h3>@image.Title</h3>

                        <p>
                            @(string.IsNullOrWhiteSpace(image.Description)
                                ? "A moment from the ImpiloYesizwe community journey."
                                : image.Description)
                        </p>

                        <small class="text-muted d-block mt-2">
                            Uploaded @image.DateUploaded.ToString("dd MMM yyyy")
                        </small>

                    </div>

                </article>
            </div>
        }
    }
    else
    {
        <div class="col-12 text-center">
            <p>
                Our community photographs will be shared here soon.
            </p>
        </div>
    }

</div>


