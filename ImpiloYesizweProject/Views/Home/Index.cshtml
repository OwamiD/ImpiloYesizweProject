            <h2>Supporting Lives, Strengthening Communities</h2>

            <p>
                Through our community programmes, we provide practical
                support and opportunities that help individuals and
                families build a better future.
            </p>
        </div>

        <div class="row g-4">

            <div class="col-md-6 col-lg-4">
                <article class="service-card">
                    <div class="service-icon">👨‍👩‍👧</div>
                    <span class="service-number">01</span>

                    <h3>Child &amp; Youth Care</h3>

                    <p>
                        Supporting children through education,
                        homework assistance and youth development
                        programmes.
                    </p>
                </article>
            </div>

            <div class="col-md-6 col-lg-4">
                <article class="service-card">
                    <div class="service-icon">🥗</div>
                    <span class="service-number">02</span>

                    <h3>Nutritional Support</h3>

                    <p>
                        Providing food parcels and nutritional
                        assistance to vulnerable families in need.
                    </p>
                </article>
            </div>

            <div class="col-md-6 col-lg-4">
                <article class="service-card">
                    <div class="service-icon">🏥</div>
                    <span class="service-number">03</span>

                    <h3>Healthcare Support</h3>

                    <p>
                        HIV counselling, TB support and promoting
                        healthier, more resilient communities.
                    </p>
                </article>
            </div>

            <div class="col-md-6 col-lg-4">
                <article class="service-card">
                    <div class="service-icon">🏠</div>
                    <span class="service-number">04</span>

                    <h3>Home-Based Care</h3>

                    <p>
                        Providing practical and emotional support
                        to individuals who need care in their homes.
                    </p>
                </article>
            </div>

            <div class="col-md-6 col-lg-4">
                <article class="service-card">
                    <div class="service-icon">🤝</div>
                    <span class="service-number">05</span>

                    <h3>Community Partnerships</h3>

                    <p>
                        Working with partners to strengthen
                        healthcare access and community wellbeing.
                    </p>
                </article>
            </div>

            <div class="col-md-6 col-lg-4">
                <article class="service-card">
                    <div class="service-icon">📚</div>
                    <span class="service-number">06</span>

                    <h3>Education Support</h3>

                    <p>
                        Helping children access stationery,
                        uniforms and after-school programmes.
                    </p>
                </article>
            </div>

        </div>

        <div class="services-bottom text-center">
            <p>Want to learn more about our programmes?</p>

            <a asp-controller="Home"
               asp-action="Contact"
               class="services-contact-btn">
                Talk to Our Team <span>→</span>
            </a>
        </div>

    </div>
</section>


