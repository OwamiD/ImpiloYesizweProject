@{
    ViewData["Title"] = "Gallery";
}

<section class="py-5">

    <div class="container">

        <div class="text-center mb-5">

            <h1 class="display-4 fw-bold text-success">
                Community Gallery
            </h1>

            <p class="lead text-muted">
                Capturing moments of hope, care and community.
            </p>

        </div>

        <div class="row g-4">

            <div class="col-md-4">
                <img src="~/images/gallery1.jpg"
                     class="gallery-img"
                     alt="Gallery">
            </div>

            <div class="col-md-4">
                <img src="~/images/gallery2.jpg"
                     class="gallery-img"
                     alt="Gallery">
            </div>

            <div class="col-md-4">
                <img src="~/images/gallery3.jpg"
                     class="gallery-img"
                     alt="Gallery">
            </div>

            <div class="col-md-4">
                <img src="~/images/gallery4.jpg"
                     class="gallery-img"
                     alt="Gallery">
            </div>

            <div class="col-md-4">
                <img src="~/images/gallery5.jpg"
                     class="gallery-img"
                     alt="Gallery">
            </div>

            <div class="col-md-4">
                <img src="~/images/gallery6.jpg"
                     class="gallery-img"
                     alt="Gallery">
            </div>

        </div>

    </div>

</section>