@model ImpiloYesizweProject.ViewModels.DonationViewModel

@{
    ViewData["Title"] = "Support Our Work";
}

<!-- ==================== DONATE PAGE HERO ==================== -->

<section class="donate-page-hero">

    <div class="container">

        <span class="section-eyebrow">MAKE A DIFFERENCE</span>

        <h1>
            Support Our <span>Mission.</span>
        </h1>

        <p>
            Your generosity can help strengthen communities
            and support individuals and families in need.
        </p>

        <div class="donate-page-breadcrumb">
            <a asp-controller="Home" asp-action="Index">Home</a>
            <span>/</span>
            <span>Donate</span>
        </div>

    </div>

</section>

<!-- ==================== DONATION PAGE CONTENT ==================== -->

<section class="donate-page-content">

    <div class="container">

        <!-- Success and error notifications -->
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success mb-4" role="status">
                @TempData["Success"]
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger mb-4" role="alert">
                @TempData["Error"]
            </div>
        }

        <div class="row g-4 align-items-stretch">

            <!-- Why Donate -->
            <div class="col-lg-5">

                <div class="donate-page-purpose">

                    <span class="donate-page-label">
                        WHY YOUR SUPPORT MATTERS
                    </span>

                    <h2>Every Contribution Counts</h2>

                    <p class="donate-page-description">
                        Your support helps ImpiloYesizwe work
                        towards improving lives and strengthening
                        communities.
                    </p>

                    <div class="donate-purpose-item">
                        <span>🍲</span>
                        <div>
                            <h3>Nutritional Support</h3>
                            <p>
                                Food parcels and assistance
                                for vulnerable families.
                            </p>
                        </div>
                    </div>

                    <div class="donate-purpose-item">
                        <span>📚</span>
                        <div>
                            <h3>Educational Support</h3>
                            <p>
                                Learning opportunities and
                                educational assistance for children.
                            </p>
                        </div>
                    </div>

                    <div class="donate-purpose-item">
                        <span>🏥</span>
                        <div>
                            <h3>Healthcare and Care</h3>
                            <p>
                                Healthcare support and
                                home-based care initiatives.
                            </p>
                        </div>
                    </div>

                    <div class="donate-purpose-item">
                        <span>🤝</span>
                        <div>
                            <h3>Community Outreach</h3>
                            <p>
                                Programmes that encourage
                                community development and support.
                            </p>
                        </div>
                    </div>

                    <div class="donate-purpose-note">
                        💚 Together, we can help create
                        stronger and more supportive communities.
                    </div>

                </div>

            </div>

            <!-- Banking and Donation Form -->
            <div class="col-lg-7">

                <div class="donate-page-main-card">

                    <!-- Banking Information -->
                    <div class="donate-banking-section">

                        <div class="donate-page-form-heading">

                            <span class="section-eyebrow">
                                BANKING INFORMATION
                            </span>

                            <h2>Official Banking Details</h2>

                            <p>
                                Use the banking information below
                                when making a contribution.
                            </p>

                        </div>

                        <div class="donate-bank-details">

                            <div class="donate-bank-row">
                                <span>Bank</span>
                                <strong>To be updated</strong>
                            </div>

                            <div class="donate-bank-row">
                                <span>Account Name</span>
                                <strong>
                                    ImpiloYesizwe Care Community Project
                                </strong>
                            </div>

                            <div class="donate-bank-row">
                                <span>Account Number</span>
                                <strong>XXXXXXXXXX</strong>
                            </div>

                            <div class="donate-bank-row">
                                <span>Branch Code</span>
                                <strong>XXXXXX</strong>
                            </div>

                            <div class="donate-bank-row">
                                <span>Reference</span>
                                <strong>Your Name + Donation</strong>
                            </div>

                        </div>

                        <div class="donate-bank-notice">
                            <span>ℹ️</span>
                            <p>
                                Please confirm the official banking
                                details with the organisation before
                                transferring any money.
                            </p>
                        </div>

                        <div class="donate-page-image">
                            <img src="~/images/Donate.jpg"
                                 asp-append-version="true"
                                 loading="lazy"
                                 alt="Support ImpiloYesizwe Care Community Project">
                        </div>

                    </div>

                    <div class="donate-form-divider"></div>

                    <!-- Donation Form -->
                    <div class="donate-form-section">

                        <div class="donate-page-form-heading">

                            <span class="section-eyebrow">
                                YOUR CONTRIBUTION
                            </span>

                            <h2>Make a Donation</h2>

                            <p>
                                Complete the details below to
                                submit your donation information.
                            </p>

                        </div>

                        <form asp-controller="Home"
                              asp-action="Donate"
                              method="post">

                            <div asp-validation-summary="ModelOnly"
                                 class="text-danger mb-3">
                            </div>

                            <div class="mb-3">

                                <label asp-for="DonorName"
                                       class="form-label">
                                </label>

                                <input asp-for="DonorName"
                                       class="form-control donate-page-input"
                                       placeholder="Enter your full name"
                                       autocomplete="name" />

                                <span asp-validation-for="DonorName"
                                      class="text-danger">
                                </span>

                            </div>

                            <div class="mb-3">

                                <label asp-for="Email"
                                       class="form-label">
                                </label>

                                <input asp-for="Email"
                                       class="form-control donate-page-input"
                                       placeholder="Enter your email address"
                                       autocomplete="email" />

                                <span asp-validation-for="Email"
                                      class="text-danger">
                                </span>

                            </div>

                            <div class="mb-4">

                                <label asp-for="Amount"
                                       class="form-label">
                                </label>

                                <div class="donate-amount-wrapper">
                                    <span>R</span>

                                    <input asp-for="Amount"
                                           class="form-control donate-page-input"
                                           placeholder="Enter donation amount"
                                           inputmode="decimal"
                                           min="1"
                                           step="0.01" />
                                </div>

                                <span asp-validation-for="Amount"
                                      class="text-danger">
                                </span>

                            </div>

                            <button type="submit"
                                    class="donate-page-submit">

                                Submit Donation Details
                                <span>→</span>

                            </button>

                        </form>

                        <p class="donate-form-small-note">
                            Thank you for considering supporting
                            ImpiloYesizwe Care Community Project.
                        </p>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
