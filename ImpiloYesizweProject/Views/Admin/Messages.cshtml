@model IEnumerable<ImpiloYesizweProject.Models.ContactMessage>

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Contact Messages";

    var messages = Model?.ToList()
        ?? new List<ImpiloYesizweProject.Models.ContactMessage>();
}

<section class="admin-management-page">
    <!-- Back to Dashboard -->

    <div class="admin-back-navigation">

        <a asp-controller="Admin"
           asp-action="Index"
           class="admin-back-link">

            <span>←</span>
            Back to Dashboard

        </a>

    </div>

    <div class="container-fluid admin-management-container">

        <!-- Page heading -->

        <div class="admin-management-heading">

            <div>
                <span class="dashboard-eyebrow">
                    ADMINISTRATION / COMMUNICATION
                </span>

                <h1>Contact Messages</h1>

                <p>
                    View and manage enquiries received from
                    the ImpiloYesizwe website.
                </p>
            </div>

            <div class="admin-record-count">
                <span>TOTAL MESSAGES</span>
                <strong>@messages.Count</strong>
            </div>

        </div>

        <!-- Messages panel -->

        <div class="admin-management-panel">

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success m-3" role="status">
                    @TempData["Success"]
                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger m-3" role="alert">
                    @TempData["Error"]
                </div>
            }
            <div class="admin-management-panel-heading">

                <div>
                    <span class="admin-management-panel-icon">📩</span>

                    <div>
                        <h2>Received Messages</h2>
                        <p>Community enquiries and contact requests</p>
                    </div>
                </div>

                <span class="admin-record-badge">
                    @messages.Count record(s)
                </span>

            </div>

            @if (messages.Any())
            {
                <div class="admin-management-table-wrapper">

                    <table class="table admin-management-table">

                        <thead>
                            <tr>
                                <th>CONTACT</th>
                                <th>PHONE</th>
                                <th>MESSAGE</th>
                                <th>DATE RECEIVED</th>
                                <th class="text-end">ACTION</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var item in messages)
                            {
                                <tr>

                                    <td>
                                        <div class="admin-message-contact">

                                            <strong>@item.FullName</strong>

                                            <a href="mailto:@item.Email">
                                                @item.Email
                                            </a>

                                        </div>
                                    </td>

                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(item.Phone))
                                        {
                                            <span class="admin-message-phone">
                                                @item.Phone
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="admin-no-value">
                                                Not provided
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        <div class="admin-message-preview"
                                             title="@item.Message">
                                            @item.Message
                                        </div>
                                    </td>

                                    <td>
                                        <span class="admin-message-date">
                                            @item.DateSent.ToString("dd MMM yyyy")
                                        </span>
                                        <small class="admin-message-time">
                                            @item.DateSent.ToString("HH:mm")
                                        </small>
                                    </td>

                                    <td class="text-end">
                                        <form asp-controller="Admin"
                                              asp-action="DeleteMessage"
                                              asp-route-id="@item.Id"
                                              method="post"
                                              class="d-inline"
                                              onsubmit="return confirm('Are you sure you want to delete this message? This action cannot be undone.');">

                                            @Html.AntiForgeryToken()

                                            <button type="submit" class="admin-delete-btn">
                                                <span>🗑️</span>
                                                Delete
                                            </button>

                                        </form>


                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="admin-management-empty">

                    <div class="admin-empty-icon">📭</div>

                    <h3>No Messages Yet</h3>

                    <p>
                        Messages submitted through the public
                        Contact page will appear here.
                    </p>

                    <a asp-controller="Home"
                       asp-action="Contact"
                       class="admin-empty-link">
                        View Contact Page →
                    </a>

                </div>
            }

        </div>

        <!-- Information note -->

        <div class="admin-management-note">
            <span>ℹ️</span>
            Contact information and messages submitted by visitors
            should be treated as confidential.
        </div>

    </div>

</section>
