@{
    Layout = "_AdminLayout";
}
@model IEnumerable<ImpiloYesizweProject.Models.ContactMessage>

@{
    ViewData["Title"] = "Messages";
}

<div class="container py-5">

    <h2 class="text-success mb-4">
        Contact Messages
    </h2>

    <table class="table table-striped table-bordered">

        <thead class="table-success">

            <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Phone</th>
                <th>Message</th>
                <th>Date</th>
                <th>Actions</th>
            </tr>

        </thead>

        <tbody>

            @foreach (var item in Model)
            {
                <tr>

                    <td>@item.FullName</td>

                    <td>@item.Email</td>

                    <td>@item.Phone</td>

                    <td>@item.Message</td>

                    <td>@item.DateSent.ToString("dd MMM yyyy")</td>

                    <td>
                        <a asp-action="DeleteMessage"
                           asp-route-id="@item.Id"
                           class="btn btn-danger btn-sm"
                           onclick="return confirm('Are you sure you want to delete this message?');">
                            Delete
                        </a>
                    </td>

                </tr>

            }


        </tbody>

    </table>

</div>