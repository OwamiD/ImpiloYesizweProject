@{
    Layout = "_AdminLayout";
}
@model ImpiloYesizweProject.Models.Service

@{
    ViewData["Title"] = "Delete Service";
}

<div class="container py-5">

    <div class="card shadow border-0">

        <div class="card-body">

            <h2 class="text-danger">
                Delete Service
            </h2>

            <hr />

            <p class="fs-5">
                Are you sure you want to delete this service?
            </p>

            <dl class="row">

                <dt class="col-sm-3">
                    Name
                </dt>

                <dd class="col-sm-9">
                    @Model.Name
                </dd>

                <dt class="col-sm-3">
                    Description
                </dt>

                <dd class="col-sm-9">
                    @Model.Description
                </dd>

                <dt class="col-sm-3">
                    Icon
                </dt>

                <dd class="col-sm-9">
                    @Model.Icon
                </dd>

            </dl>

            <form asp-action="DeleteService" method="post">

                @Html.AntiForgeryToken()

                <input asp-for="Id" type="hidden" />

                <button class="btn btn-danger">
                    Delete
                </button>

                <a asp-action="Services" class="btn btn-secondary">
                    Cancel
                </a>

            </form>

        </div>

    </div>

</div>