@{
    Layout = "_AdminLayout";
}
@model IEnumerable<ImpiloYesizweProject.Models.Donation>

@{
    ViewData["Title"] = "Donations";
}

<div class="container py-5">

    <div class="card shadow border-0">
        <div class="card-body">

            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="text-success">Donations</h2>
            </div>

            <div class="table-responsive">
                <table class="table table-hover table-bordered align-middle mb-0">

                    <thead class="table-success">
                        <tr>
                            <th>Donor</th>
                            <th>Email</th>
                            <th>Amount</th>
                            <th>Date</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.DonorName</td>
                                    <td>@item.Email</td>
                                    <td class="text-center">
                                        R @item.Amount.ToString("N2")
                                    </td>

                                    <td class="text-center">
                                        @item.DonationDate.ToString("dd MMM yyyy")
                                    </td>

                                    <td>
                                        <a asp-action="DeleteDonation"
                                           asp-route-id="@item.Id"
                                           class="btn btn-danger btn-sm"
                                           onclick="return confirm('Are you sure you want to delete this donation?');">
                                            Delete
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted">
                                    No donations have been recorded yet.
                                </td>
                            </tr>
                        }
                 </tbody>
                
                </table>
            </div>
            </div>
        </div>

    </div>