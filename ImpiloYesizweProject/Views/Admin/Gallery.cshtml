@model IEnumerable<ImpiloYesizweProject.Models.GalleryImage>

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Manage Gallery";

    var images = Model?.ToList()
        ?? new List<ImpiloYesizweProject.Models.GalleryImage>();
}

<section class="admin-management-page">

    <div class="container-fluid admin-management-container">

        <!-- Back to Dashboard -->

        <div class="admin-back-navigation">

            <a asp-controller="Admin"
               asp-action="Index"
               class="admin-back-link">
                <span>←</span>
                Back to Dashboard
            </a>

        </div>

        <!-- Page Heading -->

        <div class="admin-management-heading">

            <div>
                <span class="dashboard-eyebrow">
                    ADMINISTRATION / MEDIA MANAGEMENT
                </span>

                <h1>Gallery Management</h1>

                <p>
                    Manage photographs displayed in the
                    ImpiloYesizwe community gallery.
                </p>
            </div>

            <div class="admin-gallery-heading-actions">

                <div class="admin-record-count">
                    <span>TOTAL IMAGES</span>
                    <strong>@images.Count</strong>
                </div>

                <a asp-controller="Admin"
                   asp-action="AddGallery"
                   class="admin-gallery-add-btn">
                    <span>＋</span>
                    Add New Image
                </a>

            </div>

        </div>

        <!-- Notifications -->
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success mb-4" role="status">
                @TempData["Success"]
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger mb-4" role="alert">
                @TempData["Error"]
            </div>
        }

        <!-- Gallery Panel -->

        <div class="admin-management-panel">

            <div class="admin-management-panel-heading">

                <div>
                    <span class="admin-management-panel-icon">🖼️</span>

                    <div>
                        <h2>Community Photographs</h2>
                        <p>
                            Images currently stored in the gallery
                        </p>
                    </div>
                </div>

                <span class="admin-record-badge">
                    @images.Count image(s)
                </span>

            </div>

            @if (images.Any())
            {
                <div class="admin-gallery-grid">

                    @foreach (var image in images)
                    {
                        <article class="admin-gallery-card">

                            <div class="admin-gallery-image-wrapper">

                                <img src="@image.ImageUrl"
                                     alt="@image.Title"
                                     loading="lazy">

                                <span class="admin-gallery-image-label">
                                    GALLERY IMAGE
                                </span>

                            </div>

                            <div class="admin-gallery-card-body">

                                <h3>@image.Title</h3>

                                <div class="admin-gallery-date">
                                    <span>📅</span>
                                    Uploaded
                                    @image.DateUploaded.ToString("dd MMM yyyy")
                                </div>

                                <div class="admin-gallery-card-actions">

                                    <a href="@image.ImageUrl"
                                       target="_blank"
                                       rel="noopener noreferrer"
                                       class="admin-gallery-view-btn">
                                        View Image ↗
                                    </a>

                                    <form asp-controller="Admin"
                                          asp-action="DeleteGallery"
                                          asp-route-id="@image.Id"
                                          method="post"
                                          onsubmit="return confirm('Are you sure you want to remove this gallery image?');">

                                        <button type="submit"
                                                class="admin-gallery-delete-btn">
                                            🗑️
                                        </button>

                                    </form>

                                </div>

                            </div>

                        </article>
                    }

                </div>
            }
            else
            {
                <div class="admin-management-empty">

                    <div class="admin-empty-icon">🖼️</div>

                    <h3>Your Gallery Is Empty</h3>

                    <p>
                        Start building your community gallery
                        by uploading your first photograph.
                    </p>

                    <a asp-controller="Admin"
                       asp-action="AddGallery"
                       class="admin-empty-link">
                        + Upload Your First Image
                    </a>

                </div>
            }

        </div>

        <!-- Information Note -->

        <div class="admin-management-note">
            <span>ℹ️</span>
            Only publish photographs that the organisation
            has permission to use, particularly images of
            children and vulnerable community members.
        </div>

    </div>

</section>
