@{
    Layout = "_AdminLayout";
}
@model ImpiloYesizweProject.Models.Service

@{
    ViewData["Title"] = "Edit Service";
}

<div class="container py-5">

    <h2 class="text-success mb-4">
        Edit Service
    </h2>

    <div class="card shadow border-0">
        <div class="card-body">

            <form asp-action="EditService" method="post">

                @Html.AntiForgeryToken()

                <input asp-for="Id" type="hidden" />

                <div class="mb-3">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="5"></textarea>
                </div>

                <div class="mb-3">
                    <label asp-for="Icon" class="form-label"></label>
                    <input asp-for="Icon" class="form-control" />
                </div>

                <button class="btn btn-success">
                    Save Changes
                </button>

                <a asp-action="Services" class="btn btn-secondary">
                    Cancel
                </a>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}