@model ImpiloYesizweProject.ViewModels.DashboardViewModel

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Dashboard";

    var totalMessages = Model.TotalMessages;
    var totalDonations = Model.TotalDonations;
    var totalGalleryImages = Model.TotalGalleryImages;
    var totalRaised = Model.TotalDonationAmount;

    var maxCount = Math.Max(
    1,
    new[] {
        totalMessages,
        totalDonations,
        totalGalleryImages
    }.Max()
);

    var messagesWidth = (100.0 * totalMessages / maxCount)
        .ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) + "%";

    var donationsWidth = (100.0 * totalDonations / maxCount)
        .ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) + "%";

    var galleryWidth = (100.0 * totalGalleryImages / maxCount)
        .ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) + "%";
}

<!-- ==================== DASHBOARD ==================== -->

<section class="admin-dashboard">

    <div class="container-fluid admin-dashboard-container">

        <!-- Page Heading -->

        <div class="dashboard-page-heading">

            <div>
                <span class="dashboard-eyebrow">
                    IMPILOYESIZWE ADMINISTRATION
                </span>

                <h1>Dashboard Overview</h1>

                <p>
                    Welcome back, Administrator. Here's what's
                    happening across your organisation.
                </p>
            </div>

            <div class="dashboard-date">

                <span>TODAY</span>

                <strong>
                    @DateTime.Now.ToString("dddd, dd MMMM yyyy")
                </strong>

            </div>

        </div>

        <!-- Welcome Panel -->

        <div class="dashboard-welcome">

            <div class="dashboard-welcome-content">

                <span class="dashboard-welcome-label">
                    ADMINISTRATION PORTAL
                </span>

                <h2>Welcome, Admin! 👋</h2>

                <p>
                    Manage your organisation's messages,
                    donations and community gallery
                    from one central place.
                </p>

            </div>

            <div class="dashboard-welcome-icon">
                💚
            </div>

        </div>

        <!-- ==================== SUMMARY CARDS ==================== -->

        <div class="dashboard-section-heading">

            <div>
                <span class="dashboard-eyebrow">AT A GLANCE</span>
                <h2>Organisation Overview</h2>
            </div>

        </div>

        <div class="row g-4 dashboard-stat-row">

            <!-- Messages -->

            <div class="col-sm-6 col-xl-4">

                <article class="dashboard-stat-card">

                    <div class="dashboard-stat-top">
                        <div class="dashboard-stat-icon messages-icon">
                            📩
                        </div>

                        <span class="dashboard-stat-label">
                            MESSAGES
                        </span>
                    </div>

                    <h3>@totalMessages</h3>

                    <p>Messages received</p>

                    <a asp-controller="Admin"
                       asp-action="Messages"
                       class="dashboard-stat-link">
                        View Messages →
                    </a>

                </article>

            </div>

            <!-- Donations -->

            <div class="col-sm-6 col-xl-4">

                <article class="dashboard-stat-card">

                    <div class="dashboard-stat-top">
                        <div class="dashboard-stat-icon donations-icon">
                            💰
                        </div>

                        <span class="dashboard-stat-label">
                            ACTIVE DONATIONS
                        </span>
                    </div>

                    <h3>@totalDonations</h3>

                    <p>Active donation records</p>

                    <a asp-controller="Admin"
                       asp-action="Donations"
                       class="dashboard-stat-link">
                        View Donations →
                    </a>

                </article>

            </div>

            <!-- Gallery -->

            <div class="col-sm-6 col-xl-4">

                <article class="dashboard-stat-card">

                    <div class="dashboard-stat-top">
                        <div class="dashboard-stat-icon gallery-icon">
                            🖼️
                        </div>

                        <span class="dashboard-stat-label">
                            GALLERY
                        </span>
                    </div>

                    <h3>@totalGalleryImages</h3>

                    <p>Gallery images</p>

                    <a asp-controller="Admin"
                       asp-action="Gallery"
                       class="dashboard-stat-link">
                        Manage Gallery →
                    </a>

                </article>

            </div>

            <!-- Total Raised -->

            <div class="col-12">

                <article class="dashboard-total-raised">

                    <div class="dashboard-raised-icon">
                        ❤️
                    </div>

                    <div>
                        <span>TOTAL ACTIVE DONATIONS RECORDED</span>
                        <h3>R @totalRaised.ToString("N2")</h3>
                        <p>Total donation amount recorded in the system</p>
                    </div>

                </article>

            </div>

        </div>

        <!-- ==================== RECENT ACTIVITY ==================== -->

        <div class="dashboard-section-heading">

            <div>
                <span class="dashboard-eyebrow">LATEST UPDATES</span>
                <h2>Recent Activity</h2>
            </div>

        </div>

        <div class="row g-4 dashboard-activity-row">

            <!-- Recent Messages -->

            <div class="col-lg-6">

                <div class="dashboard-panel">

                    <div class="dashboard-panel-heading">

                        <div>
                            <span class="dashboard-panel-icon">📩</span>
                            <h3>Recent Messages</h3>
                        </div>

                        <a asp-controller="Admin"
                           asp-action="Messages">
                            View All →
                        </a>

                    </div>

                    <div class="dashboard-table-wrapper">

                        @if (Model.RecentMessages != null &&
                             Model.RecentMessages.Any())
                        {
                            <table class="table dashboard-table">

                                <thead>
                                    <tr>
                                        <th>NAME</th>
                                        <th>DATE RECEIVED</th>
                                    </tr>
                                </thead>

                                <tbody>

                                    @foreach (var message in Model.RecentMessages)
                                    {
                                        <tr>
                                            <td>
                                                <strong>@message.FullName</strong>
                                            </td>

                                            <td>
                                                @message.DateSent.ToString("dd MMM yyyy")
                                            </td>
                                        </tr>
                                    }

                                </tbody>

                            </table>
                        }
                        else
                        {
                            <div class="dashboard-empty-state">
                                <span>📭</span>
                                <h4>No Messages Yet</h4>
                                <p>New enquiries will appear here.</p>
                            </div>
                        }

                    </div>

                </div>

            </div>

            <!-- Recent Donations -->

            <div class="col-lg-6">

                <div class="dashboard-panel">

                    <div class="dashboard-panel-heading">

                        <div>
                            <span class="dashboard-panel-icon">💰</span>
                            <h3>Recent Donations</h3>
                        </div>

                        <a asp-controller="Admin"
                           asp-action="Donations">
                            View All →
                        </a>

                    </div>

                    <div class="dashboard-table-wrapper">

                        @if (Model.RecentDonations != null &&
                             Model.RecentDonations.Any())
                        {
                            <table class="table dashboard-table">

                                <thead>
                                    <tr>
                                        <th>DONOR</th>
                                        <th>AMOUNT</th>
                                    </tr>
                                </thead>

                                <tbody>

                                    @foreach (var donation in Model.RecentDonations)
                                    {
                                        <tr>
                                            <td>
                                                <strong>@donation.DonorName</strong>
                                            </td>

                                            <td class="dashboard-donation-amount">
                                                R @donation.Amount.ToString("N2")
                                            </td>
                                        </tr>
                                    }

                                </tbody>

                            </table>
                        }
                        else
                        {
                            <div class="dashboard-empty-state">
                                <span>💚</span>
                                <h4>No Donations Yet</h4>
                                <p>Donation records will appear here.</p>
                            </div>
                        }

                    </div>

                </div>

            </div>

        </div>

        <!-- ==================== SYSTEM STATISTICS ==================== -->

        <div class="dashboard-section-heading">

            <div>
                <span class="dashboard-eyebrow">SYSTEM ACTIVITY</span>
                <h2>System Statistics</h2>
            </div>

        </div>

        <div class="dashboard-statistics-panel">

            <div class="dashboard-statistics-heading">
                <div>
                    <h3>Record Summary</h3>
                    <p>Overview of records currently stored in the system.</p>
                </div>

                <span class="dashboard-live-label">
                    DATABASE TOTALS
                </span>
            </div>

            <div class="dashboard-chart">

                <div class="dashboard-chart-row">

                    <div class="dashboard-chart-label">
                        <span>📩 Messages</span>
                        <strong>@totalMessages</strong>
                    </div>

                    <div class="dashboard-chart-track">
                        <div class="dashboard-chart-fill messages-bar"
                             style="width: @messagesWidth">
                        </div>
                    </div>

                </div>

                <div class="dashboard-chart-row">

                    <div class="dashboard-chart-label">
                        <span>💰 Donations</span>
                        <strong>@totalDonations</strong>
                    </div>

                    <div class="dashboard-chart-track">
                        <div class="dashboard-chart-fill donations-bar"
                             style="width: @donationsWidth">
                        </div>
                    </div>

                </div>

                <div class="dashboard-chart-row">

                    <div class="dashboard-chart-label">
                        <span>🖼️ Gallery Images</span>
                        <strong>@totalGalleryImages</strong>
                    </div>

                    <div class="dashboard-chart-track">
                        <div class="dashboard-chart-fill gallery-bar"
                             style="width: @galleryWidth">
                        </div>
                    </div>

                </div>

            </div>

        </div>

        <!-- ==================== QUICK MANAGEMENT ==================== -->

        <div class="dashboard-section-heading">

            <div>
                <span class="dashboard-eyebrow">ADMIN TOOLS</span>
                <h2>Quick Management</h2>
            </div>

        </div>

        <div class="row g-3 dashboard-quick-actions">

            <div class="col-sm-6 col-lg-3">
                <a asp-controller="Admin"
                   asp-action="Messages"
                   class="dashboard-quick-action">
                    <span>📩</span>
                    <strong>Manage Messages</strong>
                    <small>View and manage enquiries</small>
                    <b>→</b>
                </a>
            </div>

            <div class="col-sm-6 col-lg-3">
                <a asp-controller="Admin"
                   asp-action="Donations"
                   class="dashboard-quick-action">
                    <span>💰</span>
                    <strong>Manage Donations</strong>
                    <small>Review donation records</small>
                    <b>→</b>
                </a>
            </div>

            <div class="col-sm-6 col-lg-3">
                <a asp-controller="Admin"
                   asp-action="Gallery"
                   class="dashboard-quick-action">
                    <span>🖼️</span>
                    <strong>Manage Gallery</strong>
                    <small>Maintain gallery images</small>
                    <b>→</b>
                </a>
            </div>

            <div class="col-sm-6 col-lg-3">
                <a asp-controller="Admin"
                   asp-action="AddAdmin"
                   class="dashboard-quick-action">
                    <span>👤</span>
                    <strong>Add Administrator</strong>
                    <small>Manage administrator access</small>
                    <b>→</b>
                </a>
            </div>
 
            <div class="col-sm-6 col-lg-3">

                <a asp-controller="Admin"
                   asp-action="AuditLogs"
                   class="dashboard-quick-action">

                    <span>📋</span>

                    <strong>Audit History</strong>

                    <small>Review administrator activity</small>

                    <b>→</b>

                </a>

            </div>


        </div>

    </div>

</section>
